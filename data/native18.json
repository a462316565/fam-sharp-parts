[
 {
  "i": 0,
  "en": "I don't believe it.",
  "cn": "我真不敢相信！",
  "score": 1.0
 },
 {
  "i": 1,
  "en": "What's wrong?",
  "cn": "怎么了?",
  "score": 1.0
 },
 {
  "i": 2,
  "en": "Carter Boswell.",
  "cn": "卡特·博斯韦尔！",
  "score": 1.0
 },
 {
  "i": 3,
  "en": "Who's Carter Boswell?",
  "cn": "卡特·博斯韦尔是谁？",
  "score": 1.0
 },
 {
  "i": 4,
  "en": "He's running for the school board,",
  "cn": "他竞选教育委员会。",
  "score": 1.0
 },
 {
  "i": 5,
  "en": "the elections next month.",
  "cn": "选举下个月。",
  "score": 0.83
 },
 {
  "i": 6,
  "en": "What's wrong with wanting to be on the school board?",
  "cn": "怎么了",
  "score": 1.0
 },
 {
  "i": 7,
  "en": "Nothing.",
  "cn": "没什么。",
  "score": 1.0
 },
 {
  "i": 8,
  "en": "But he wants to cut the school budget.",
  "cn": "但他要削减学校预算！",
  "score": 1.0
 },
 {
  "i": 9,
  "en": "Maybe he needs cutting.",
  "cn": "也许确实需要削减。",
  "score": 0.79
 },
 {
  "i": 10,
  "en": "Cutting the budget is fine, but he wants to do it",
  "cn": "削减预算可以，",
  "score": 0.6
 },
 {
  "i": 11,
  "en": "by cutting all the cultural programs.",
  "cn": "所有文化项目来实现。",
  "score": 1.0
 },
 {
  "i": 12,
  "en": "No music, no dance, no concert, no stage presentations.",
  "cn": "没有音乐会，没有舞台演出。",
  "score": 0.74
 },
 {
  "i": 13,
  "en": "Why does he want to do that?",
  "cn": "他为什么要这么做？",
  "score": 1.0
 },
 {
  "i": 14,
  "en": "He says it's to save the taxpayers money.",
  "cn": "他说这是为了给纳税人省钱，",
  "score": 0.9
 },
 {
  "i": 15,
  "en": "And I think he believes that the taxpayers will vote for him",
  "cn": "如果他在文化项目上少花钱，",
  "score": 0.68
 },
 {
  "i": 16,
  "en": "if he spends less on the cultural programs.",
  "cn": "纳税人就会投他的票。",
  "score": 1.0
 },
 {
  "i": 17,
  "en": "He's probably right.",
  "cn": "他可能是对的。",
  "score": 1.0
 },
 {
  "i": 18,
  "en": "Lots of people want their taxes used",
  "cn": "很多人希望他们的税收",
  "score": 0.9
 },
 {
  "i": 19,
  "en": "for new books and new paint jobs in the schoolrooms.",
  "cn": "和教室的重新粉刷。",
  "score": 0.7
 },
 {
  "i": 20,
  "en": "Maybe some of us would like to pay a little bit more",
  "cn": "也许我们中有些人愿意多付一点，",
  "score": 1.0
 },
 {
  "i": 21,
  "en": "and keep the cultural programs for our kids?",
  "cn": "为孩子们保留文化项目。",
  "score": 1.0
 },
 {
  "i": 22,
  "en": "Well, I'm not sure, Ellen.",
  "cn": "嗯，我不确定。埃伦。",
  "score": 1.0
 },
 {
  "i": 23,
  "en": "I hear it from my patients.",
  "cn": "我从病人那里听到的。",
  "score": 1.0
 },
 {
  "i": 24,
  "en": "Lots of people are tired of higher taxes.",
  "cn": "很多人厌倦了越来越高的税。",
  "score": 1.0
 },
 {
  "i": 25,
  "en": "I know.",
  "cn": "我知道,",
  "score": 1.0
 },
 {
  "i": 26,
  "en": "But if Boswell wins, he'll be an important decision maker",
  "cn": "他就会成为教委里",
  "score": 0.71
 },
 {
  "i": 27,
  "en": "on the school board.",
  "cn": "重要的决策者，",
  "score": 1.0
 },
 {
  "i": 28,
  "en": "And he doesn't know anything about our children's education.",
  "cn": "而他对",
  "score": 0.61
 },
 {
  "i": 29,
  "en": "Who's running against him?",
  "cn": "谁和他竞选？",
  "score": 1.0
 },
 {
  "i": 30,
  "en": "Nobody.",
  "cn": "没人。",
  "score": 0.3
 },
 {
  "i": 31,
  "en": "That's the problem.",
  "cn": "没人。这就是问题所在。",
  "score": 0.8
 },
 {
  "i": 32,
  "en": "Well, it sounds to me like Carter Boswell",
  "cn": "嗯，听起来卡特·博斯韦尔",
  "score": 1.0
 },
 {
  "i": 33,
  "en": "is going to win the seat on the board.",
  "cn": "会赢得这个席位。",
  "score": 0.93
 },
 {
  "i": 34,
  "en": "Not if I can stop him.",
  "cn": "哦，只要我能阻止他！",
  "score": 0.9
 },
 {
  "i": 35,
  "en": "And how are you going to stop him?",
  "cn": "那你要怎么阻止他？",
  "score": 1.0
 },
 {
  "i": 36,
  "en": "Maybe I'll run against him.",
  "cn": "也许我出来和他竞选。",
  "score": 1.0
 },
 {
  "i": 37,
  "en": "Well, you've got my vote.",
  "cn": "嗯，我投你一票。",
  "score": 1.0
 },
 {
  "i": 38,
  "en": "I'm serious, Philip.",
  "cn": "我是认真的，菲利普。",
  "score": 1.0
 },
 {
  "i": 39,
  "en": "Why shouldn't I run?",
  "cn": "我为什么不应该竞选？",
  "score": 1.0
 },
 {
  "i": 40,
  "en": "Why shouldn't you run for what, Mom?",
  "cn": "你不应该竞选什么，妈妈？",
  "score": 1.0
 },
 {
  "i": 41,
  "en": "Your mother is thinking of running for the school board.",
  "cn": "竞选教委。",
  "score": 0.6
 },
 {
  "i": 42,
  "en": "Hey, that's terrific, Mom.",
  "cn": "嘿，太棒了，妈妈！",
  "score": 1.0
 },
 {
  "i": 43,
  "en": "Against Carter Boswell?",
  "cn": "对卡特·博斯韦尔？",
  "score": 1.0
 },
 {
  "i": 44,
  "en": "Great.",
  "cn": "太好了!",
  "score": 1.0
 },
 {
  "i": 45,
  "en": "Well, if I run for office, the voters",
  "cn": "嗯，如果我竞选，",
  "score": 0.79
 },
 {
  "i": 46,
  "en": "will have a clear choice.",
  "cn": "选民会有明确的选择。",
  "score": 0.77
 },
 {
  "i": 47,
  "en": "I stand for everything Boswell doesn't.",
  "cn": "我代表博斯韦尔所反对的一切。",
  "score": 1.0
 },
 {
  "i": 48,
  "en": "I think a lot of people will vote for you",
  "cn": "我认为",
  "score": 1.0
 },
 {
  "i": 49,
  "en": "against Boswell, Ellen.",
  "cn": "反对博斯韦尔，会有很多人投你，埃伦。",
  "score": 1.0
 },
 {
  "i": 50,
  "en": "I'll vote for you.",
  "cn": "我投你。",
  "score": 1.0
 },
 {
  "i": 51,
  "en": "Will you help me if I do run?",
  "cn": "你会",
  "score": 1.0
 },
 {
  "i": 52,
  "en": "Absolutely.",
  "cn": "如果我竞选，你愿意帮我吗？",
  "score": 1.0
 },
 {
  "i": 53,
  "en": "The trouble is, it takes a little bit of money",
  "cn": "问题是，",
  "score": 0.6
 },
 {
  "i": 54,
  "en": "to run a campaign.",
  "cn": "在短期竞选里，",
  "score": 0.5
 },
 {
  "i": 55,
  "en": "I think you can make a difference, Ellen.",
  "cn": "竞选需要一些钱。",
  "score": 1.0
 },
 {
  "i": 56,
  "en": "And in a short campaign, you wouldn't need as much money.",
  "cn": "你不需要那么多钱。",
  "score": 0.65
 },
 {
  "i": 57,
  "en": "You know something, Ellen?",
  "cn": "你知道吗，埃伦？",
  "score": 1.0
 },
 {
  "i": 58,
  "en": "Why not give the people of Riverdale a clear choice?",
  "cn": "何不给里弗代尔的人一个明确的选择？",
  "score": 1.0
 },
 {
  "i": 59,
  "en": "I'm with you.",
  "cn": "我支持你。",
  "score": 1.0
 },
 {
  "i": 60,
  "en": "You can make a difference.",
  "cn": "你能有所作为。",
  "score": 1.0
 },
 {
  "i": 61,
  "en": "Mr. Maxwell.",
  "cn": "麦克斯韦先生？",
  "score": 1.0
 },
 {
  "i": 62,
  "en": "Yes.",
  "cn": "是的.",
  "score": 1.0
 },
 {
  "i": 63,
  "en": "Charles Maxwell.",
  "cn": "是的，查尔斯·麦克斯韦。",
  "score": 0.8
 },
 {
  "i": 64,
  "en": "My name is Ellen Stewart.",
  "cn": "我叫埃伦·斯图尔特。",
  "score": 1.0
 },
 {
  "i": 65,
  "en": "Hello.",
  "cn": "你好.",
  "score": 1.0
 },
 {
  "i": 66,
  "en": "Please, sit down.",
  "cn": "请坐。",
  "score": 1.0
 },
 {
  "i": 67,
  "en": "You asked to see me.",
  "cn": "你要见我。",
  "score": 1.0
 },
 {
  "i": 68,
  "en": "What would you like to see me about?",
  "cn": "你想和我谈什么？",
  "score": 1.0
 },
 {
  "i": 69,
  "en": "I'd like your help.",
  "cn": "我希望得到你的帮助。",
  "score": 1.0
 },
 {
  "i": 70,
  "en": "Editor of the most influential newspaper in Riverdale.",
  "cn": "我是里弗代尔最有影响力的报纸的编辑。",
  "score": 0.93
 },
 {
  "i": 71,
  "en": "Actually, it's the only newspaper.",
  "cn": "其实，这是唯一的报纸。",
  "score": 1.0
 },
 {
  "i": 72,
  "en": "A lot of people would like my help.",
  "cn": "很多人都想要我的帮助。",
  "score": 1.0
 },
 {
  "i": 73,
  "en": "Do you have a story?",
  "cn": "你有新闻吗？",
  "score": 1.0
 },
 {
  "i": 74,
  "en": "I'm planning to run for the school board.",
  "cn": "我打算竞选教委。",
  "score": 1.0
 },
 {
  "i": 75,
  "en": "Against Carter Boswell?",
  "cn": "对卡特·博斯韦尔？",
  "score": 1.0
 },
 {
  "i": 76,
  "en": "Yes.",
  "cn": "是的",
  "score": 0.3
 },
 {
  "i": 77,
  "en": "Well, that is news.",
  "cn": "嗯，这可是新闻。",
  "score": 1.0
 },
 {
  "i": 78,
  "en": "Will you announce that I'm running?",
  "cn": "你会",
  "score": 1.0
 },
 {
  "i": 79,
  "en": "Sure.",
  "cn": "理查德：当然。",
  "score": 0.5
 },
 {
  "i": 80,
  "en": "But I need some information.",
  "cn": "但我需要一些信息。",
  "score": 1.0
 },
 {
  "i": 81,
  "en": "Of course.",
  "cn": "当然.",
  "score": 1.0
 },
 {
  "i": 82,
  "en": "Why will the voters vote for you against Boswell,",
  "cn": "为什么选民会投你而不投博斯韦尔，",
  "score": 1.0
 },
 {
  "i": 83,
  "en": "Mrs. Stewart?",
  "cn": "斯图尔特夫人？",
  "score": 1.0
 },
 {
  "i": 84,
  "en": "Because I care.",
  "cn": "因为我关心。",
  "score": 1.0
 },
 {
  "i": 85,
  "en": "Vote for Ellen Stewart.",
  "cn": "「投埃伦·斯图尔特一票。她关心。」",
  "score": 0.76
 },
 {
  "i": 86,
  "en": "She cares.",
  "cn": "她关心",
  "score": 0.3
 },
 {
  "i": 87,
  "en": "Not a bad slogan.",
  "cn": "口号不错。",
  "score": 1.0
 },
 {
  "i": 88,
  "en": "But what do you care about?",
  "cn": "但你关心什么？",
  "score": 1.0
 },
 {
  "i": 89,
  "en": "I care about the children of our town.",
  "cn": "嗯，我关心镇上的孩子们。",
  "score": 0.92
 },
 {
  "i": 90,
  "en": "I don't want them to grow up without cultural programs",
  "cn": "我不想他们成长",
  "score": 0.69
 },
 {
  "i": 91,
  "en": "in our school.",
  "cn": "时学校没有文化项目。",
  "score": 0.5
 },
 {
  "i": 92,
  "en": "Do you have a plan?",
  "cn": "你有方案吗？",
  "score": 1.0
 },
 {
  "i": 93,
  "en": "I want our children to learn more",
  "cn": "我想要",
  "score": 0.89
 },
 {
  "i": 94,
  "en": "than reading, writing, and arithmetic.",
  "cn": "我希望我们的孩子学到的",
  "score": 0.89
 },
 {
  "i": 95,
  "en": "I want to keep the after-school programs, the music,",
  "cn": "不仅是阅读、写作和算术。",
  "score": 0.89
 },
 {
  "i": 96,
  "en": "the concerts.",
  "cn": "我想保留课后项目——",
  "score": 0.69
 },
 {
  "i": 97,
  "en": "It's not a bad plan.",
  "cn": "音乐、音乐会。",
  "score": 1.0
 },
 {
  "i": 98,
  "en": "But who's going to pay for all of this?",
  "cn": "方案不错。",
  "score": 1.0
 },
 {
  "i": 99,
  "en": "We are.",
  "cn": "但谁来为此付费？",
  "score": 1.0
 },
 {
  "i": 100,
  "en": "The citizens of Riverdale, of course.",
  "cn": "我们。",
  "score": 1.0
 },
 {
  "i": 101,
  "en": "I plan to get help from the businessmen",
  "cn": "当然是里弗代尔的市民。",
  "score": 0.63
 },
 {
  "i": 102,
  "en": "and the corporations of Riverdale.",
  "cn": "和这公司的Riverdale.",
  "score": 0.3
 },
 {
  "i": 103,
  "en": "That's fair enough.",
  "cn": "我打算寻求帮助。",
  "score": 1.0
 },
 {
  "i": 104,
  "en": "Exactly what do you want from me, Mrs. Stewart?",
  "cn": "这很合理。",
  "score": 1.0
 },
 {
  "i": 105,
  "en": "You don't know me.",
  "cn": "你究竟想从我这里得到什么，斯图尔特夫人？",
  "score": 1.0
 },
 {
  "i": 106,
  "en": "I can't expect you to take my side against Boswell.",
  "cn": "你不认识我。",
  "score": 1.0
 },
 {
  "i": 107,
  "en": "But I do need some publicity so that the people of our town",
  "cn": "但我确实需要一些宣传，",
  "score": 0.62
 },
 {
  "i": 108,
  "en": "know that I'm running for office",
  "cn": "这样镇上的人",
  "score": 1.0
 },
 {
  "i": 109,
  "en": "and that I care about our children.",
  "cn": "就知道我在竞选，",
  "score": 1.0
 },
 {
  "i": 110,
  "en": "Fair enough.",
  "cn": "而且我关心我们的孩子。",
  "score": 1.0
 },
 {
  "i": 111,
  "en": "I certainly can print the news.",
  "cn": "合理。",
  "score": 1.0
 },
 {
  "i": 112,
  "en": "And you are now making news.",
  "cn": "我当然可以刊登这则新闻。",
  "score": 1.0
 },
 {
  "i": 113,
  "en": "Here are the flyers.",
  "cn": "爷爷：传单来了，刚出炉！",
  "score": 0.48
 },
 {
  "i": 114,
  "en": "Hot off the press.",
  "cn": "热off这印刷",
  "score": 0.3
 },
 {
  "i": 115,
  "en": "Looks good.",
  "cn": "埃伦：看起来不错。简洁。",
  "score": 0.56
 },
 {
  "i": 116,
  "en": "Simple.",
  "cn": "简单",
  "score": 0.3
 },
 {
  "i": 117,
  "en": "Right over here, Grandpa.",
  "cn": "对越过这里Grandpa.",
  "score": 0.3
 },
 {
  "i": 118,
  "en": "You fold the flyers.",
  "cn": "爷爷：我折传单。",
  "score": 0.52
 },
 {
  "i": 119,
  "en": "Richard and I will put them into the envelopes.",
  "cn": "玛丽莲：就在那边，爷爷。你折传单，理查德和我把它们装进信封。",
  "score": 0.59
 },
 {
  "i": 120,
  "en": "We finished addressing over 300 envelopes.",
  "cn": "理查德：我们写完了三百多个信封的地址。",
  "score": 0.68
 },
 {
  "i": 121,
  "en": "Need another box?",
  "cn": "爷爷：再要一盒吗？",
  "score": 0.78
 },
 {
  "i": 122,
  "en": "Good work, gang.",
  "cn": "埃伦：干得好，伙计们。",
  "score": 0.79
 },
 {
  "i": 123,
  "en": "Hi, this is Mike Johnson.",
  "cn": "Hi,这是MikeJohnson.",
  "score": 0.3
 },
 {
  "i": 124,
  "en": "Can I speak with Mr. and Mrs. Anderson?",
  "cn": "迈克：嗨，我是迈克·约翰逊。能和安德森先生或夫人说话吗？谢谢。",
  "score": 0.56
 },
 {
  "i": 125,
  "en": "Mr. Nelson?",
  "cn": "Mr.Nelson?",
  "score": 0.3
 },
 {
  "i": 126,
  "en": "Hi, this is Robbie Stewart.",
  "cn": "Hi,这是RobbieStewart.",
  "score": 0.3
 },
 {
  "i": 127,
  "en": "Did you know my mother is running for the school board?",
  "cn": "罗比：纳尔逊先生。嗨。我是罗比·斯图尔特。您知道我妈妈竞选教委吗？",
  "score": 0.69
 },
 {
  "i": 128,
  "en": "Yes, Miss Kim.",
  "cn": "是想念Kim.",
  "score": 0.3
 },
 {
  "i": 129,
  "en": "Ellen Stewart.",
  "cn": "埃伦：我输了。",
  "score": 0.48
 },
 {
  "i": 130,
  "en": "She cares.",
  "cn": "她关心",
  "score": 0.3
 },
 {
  "i": 131,
  "en": "See you at the polls.",
  "cn": "看你在这投票站",
  "score": 0.3
 },
 {
  "i": 132,
  "en": "Certainly.",
  "cn": "当然",
  "score": 0.3
 },
 {
  "i": 133,
  "en": "I'll give you your best wishes, Mr. Nelson.",
  "cn": "罗比：当然，我会转达您的祝福，纳尔逊先生。",
  "score": 0.63
 },
 {
  "i": 134,
  "en": "Hi, this is Mike Johnson.",
  "cn": "Hi,这是MikeJohnson.",
  "score": 0.3
 },
 {
  "i": 135,
  "en": "Can I speak with Mr. and Mrs. Burns?",
  "cn": "迈克：嗨，我是迈克·约翰逊。能和伯恩斯先生或夫人说话吗？谢谢。",
  "score": 0.52
 },
 {
  "i": 136,
  "en": "Thank you.",
  "cn": "谢谢你",
  "score": 0.3
 },
 {
  "i": 137,
  "en": "We have done so much in such a short amount of time.",
  "cn": "埃伦：我们在这么短的时间里做了这么多。我真不敢相信！等菲利普来看到我们的进展！",
  "score": 0.54
 },
 {
  "i": 138,
  "en": "I can't believe it.",
  "cn": "我不能相信它",
  "score": 0.3
 },
 {
  "i": 139,
  "en": "Wait till Philip comes home and sees our progress.",
  "cn": "等tillPhilip来home和看我们的进展",
  "score": 0.3
 },
 {
  "i": 140,
  "en": "Everyone saw the story in the Riverdale newspaper.",
  "cn": "罗比：大家都看到了里弗代尔报纸上的报道。",
  "score": 0.88
 },
 {
  "i": 141,
  "en": "Mr. Maxwell was very kind to print my announcement.",
  "cn": "埃伦：麦克斯韦先生很客气地刊登了我的声明。",
  "score": 0.93
